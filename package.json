{
  "name": "docker-canvas",
  "displayName": "Docker Canvas",
  "description": "Pannable, zoomable canvas of your Docker containers with live updates",
  "version": "0.1.0",
  "publisher": "legion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlosHPlata/docker-canvas"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dockerCanvas.openCanvas",
        "title": "Docker Canvas: Open"
      },
      {
        "command": "dockerCanvas.listContainers",
        "title": "Docker Canvas: List Containers"
      },
      {
        "command": "dockerCanvas.startContainer",
        "title": "Start Container"
      },
      {
        "command": "dockerCanvas.stopContainer",
        "title": "Stop Container"
      },
      {
        "command": "dockerCanvas.restartContainer",
        "title": "Restart Container"
      },
      {
        "command": "dockerCanvas.resetLayout",
        "title": "Docker Canvas: Reset Layout"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dockerCanvas.openCanvas"
        },
        {
          "command": "dockerCanvas.listContainers"
        },
        {
          "command": "dockerCanvas.resetLayout"
        },
        {
          "command": "dockerCanvas.startContainer",
          "when": "false"
        },
        {
          "command": "dockerCanvas.stopContainer",
          "when": "false"
        },
        {
          "command": "dockerCanvas.restartContainer",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "dockerCanvas.startContainer",
          "when": "webviewId == 'dockerCanvas' && webviewSection == 'container' && !running",
          "group": "containers@1"
        },
        {
          "command": "dockerCanvas.stopContainer",
          "when": "webviewId == 'dockerCanvas' && webviewSection == 'container' && running",
          "group": "containers@2"
        },
        {
          "command": "dockerCanvas.restartContainer",
          "when": "webviewId == 'dockerCanvas' && webviewSection == 'container' && running",
          "group": "containers@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "compile-check": "tsc --noEmit && tsc -p tsconfig.webview.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.3.6",
    "dockerode": "^4.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.36",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
